#!/usr/bin/env bash

# Notes
# - Can use `advpng -z <image>` to re-compress with a better algorithm after optipng
# - Can use `magick convert <input-image> -alpha off <output-image>` to turn alpha off

# Recently upgraded to oxipng from optipng

optimize_pngs_in_folder() {
  # Docs: https://github.com/shssoichiro/oxipng/blob/master/MANUAL.txt
  # --fix not used, but it could be if there are "checksum errors"
  oxipng --opt 3 --strip all "**/*.png"
}

optimize_pngs_in_folder "$@"
